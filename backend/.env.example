# ========================================================
# PostMind Backend Environment Variables Template
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Neon DB (PostgreSQL)
# Pooled connection URL (recommended for general application queries)
DATABASE_URL="postgresql://username:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection URL (required for Prisma migrations)
DIRECT_URL="postgresql://username:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Supabase Auth & Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Data Security & Cryptography
# 32-byte hex key for encrypting OAuth tokens at rest (generate with: openssl rand -hex 32)
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# AI Copywriting & LLM Provider (AgentRouter / OpenAI compatible)
AGENTROUTER_API_KEY="your-agentrouter-api-key"
AI_BASE_URL="https://agentrouter.org/v1"
AI_MODEL="glm-5.3"

# Google Gemini API (Alternative AI Provider / Multimodal)
GEMINI_API_KEY="your-google-gemini-api-key"

# Cloudflare Workers AI (Creative Image Generation)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"

# Meta Graph API (Facebook Pages & Instagram)
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_REDIRECT_URI="http://localhost:5000/auth/callback/facebook"
