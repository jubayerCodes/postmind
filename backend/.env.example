# PostMind Backend Environment Variables

# Application
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Neon DB (PostgreSQL)
# Pooled connection string (recommended for general queries)
DATABASE_URL="postgresql://neondb_owner:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (recommended for Prisma migrations)
DIRECT_URL="postgresql://neondb_owner:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Supabase Auth & Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# AI Provider (AgentRouter.org / glm-5.3)
AGENTROUTER_API_KEY="your-agentrouter-api-key"
AI_BASE_URL="https://agentrouter.org/v1"
AI_MODEL="glm-5.3"
