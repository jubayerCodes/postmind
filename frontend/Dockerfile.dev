FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache libc6-compat

# Copy dependency manifests
COPY package*.json ./

# Install all dependencies (including devDependencies required for next dev)
RUN npm install

# Copy source code
COPY . .

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NODE_ENV=development
ENV WATCHPACK_POLLING=true

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0"]
