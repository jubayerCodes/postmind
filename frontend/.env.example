# ========================================================
# PostMind Frontend Environment Variables Template
# ========================================================

# Backend API URL (use /api/backend for Next.js internal rewrite proxy, or direct URL)
NEXT_PUBLIC_API_URL=/api/backend

# Internal Backend URL for Server-Side Proxying (Next.js API route proxy)
BACKEND_INTERNAL_URL=http://localhost:5000

# Supabase Auth & Public Client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
